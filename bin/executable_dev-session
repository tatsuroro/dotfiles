#!/usr/bin/env bash
set -euo pipefail

CONFIG="${DEV_SESSION_CONFIG:-$HOME/.config/dev-sessions.yml}"

die() { echo "error: $*" >&2; exit 1; }

require_config() {
  [[ -f "$CONFIG" ]] || die "config not found: $CONFIG"
  command -v yq &>/dev/null || die "yq is required (brew install yq)"
  command -v tmux &>/dev/null || die "tmux is required (brew install tmux)"
}

list_sessions() {
  require_config
  yq '.sessions | keys | .[]' "$CONFIG"
}

resolve_session() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    name=$(yq '.sessions | keys | .[0]' "$CONFIG")
  fi
  echo "$name"
}

session_exists() {
  tmux has-session -t "$1" 2>/dev/null
}

start_session() {
  require_config
  local session force
  force="${1:-}"
  if [[ "$force" == "--force" ]]; then
    session=$(resolve_session "${2:-}")
  else
    session=$(resolve_session "${1:-}")
  fi

  if session_exists "$session"; then
    if [[ "$force" == "--force" ]]; then
      tmux kill-session -t "$session"
      echo "killed existing session '$session'."
    else
      echo "session '$session' is already running."
      echo "  dev-session attach $session  - attach to it"
      echo "  dev-session start --force $session  - recreate it"
      return 0
    fi
  fi

  local win_count
  win_count=$(yq ".sessions.${session}.windows | length" "$CONFIG")
  [[ "$win_count" -gt 0 ]] || die "no windows defined for session '$session'"

  echo "starting session '$session' ($win_count windows)..."

  local session_created=false

  for w in $(seq 0 $((win_count - 1))); do
    local win_name layout pane_count
    win_name=$(yq -r ".sessions.${session}.windows[$w].name" "$CONFIG")
    layout=$(yq -r ".sessions.${session}.windows[$w].layout // \"even-horizontal\"" "$CONFIG")
    pane_count=$(yq ".sessions.${session}.windows[$w].panes | length" "$CONFIG")

    if [[ "$pane_count" -eq 0 ]]; then
      echo "  skip window: $win_name (no panes)"
      continue
    fi

    local first_dir
    first_dir=$(yq -r ".sessions.${session}.windows[$w].panes[0].dir" "$CONFIG")
    first_dir="${first_dir/#\~/$HOME}"

    if ! $session_created; then
      tmux new-session -d -s "$session" -n "$win_name" -c "$first_dir"
      session_created=true
    else
      tmux new-window -t "$session" -n "$win_name" -c "$first_dir"
    fi

    for p in $(seq 1 $((pane_count - 1))); do
      local pane_dir
      pane_dir=$(yq -r ".sessions.${session}.windows[$w].panes[$p].dir" "$CONFIG")
      pane_dir="${pane_dir/#\~/$HOME}"
      tmux split-window -t "${session}:${win_name}" -h -c "$pane_dir"
    done

    tmux select-layout -t "${session}:${win_name}" "$layout"

    local pane_base
    pane_base=$(tmux show-options -gv pane-base-index 2>/dev/null || echo 0)

    for p in $(seq 0 $((pane_count - 1))); do
      local pane_idx=$((p + pane_base))
      local pane_cmd
      pane_cmd=$(yq -r ".sessions.${session}.windows[$w].panes[$p].cmd" "$CONFIG")
      tmux send-keys -t "${session}:${win_name}.${pane_idx}" "$pane_cmd" C-m
    done

    echo "  window: $win_name ($pane_count panes, layout: $layout)"
  done

  echo "done. use 'dev-session attach $session' to connect."
}

attach_session() {
  local session
  session=$(resolve_session "${1:-}")

  if ! session_exists "$session"; then
    die "session '$session' is not running. use 'start' first."
  fi

  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

stop_session() {
  local session
  session=$(resolve_session "${1:-}")

  if ! session_exists "$session"; then
    echo "session '$session' is not running."
    return 0
  fi

  tmux kill-session -t "$session"
  echo "stopped session '$session'."
}

restart_session() {
  local session
  session=$(resolve_session "${1:-}")
  start_session --force "$session"
}

show_status() {
  if ! tmux list-sessions 2>/dev/null; then
    echo "no tmux sessions running."
  fi
}

case "${1:-}" in
  start)   start_session "${2:-}" "${3:-}" ;;
  attach|a) attach_session "${2:-}" ;;
  stop)    stop_session "${2:-}" ;;
  restart) restart_session "${2:-}" ;;
  list|ls) list_sessions ;;
  status)  show_status ;;
  *)
    echo "Usage: dev-session <command> [session-name]"
    echo ""
    echo "Commands:"
    echo "  start [name]          Start a tmux session"
    echo "  start --force [name]  Kill and recreate a session"
    echo "  attach [name]         Attach to a running session (alias: a)"
    echo "  stop [name]           Kill a session and all its processes"
    echo "  restart [name]        Alias for start --force"
    echo "  list                  List configured sessions"
    echo "  status                Show running tmux sessions"
    echo ""
    echo "Config: $CONFIG"
    ;;
esac
